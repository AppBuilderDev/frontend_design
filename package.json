{
  "name": "frontend-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --port 5173 --strictPort",
    "test": "vitest run",
    "api": "tsx --env-file-if-exists=.env server/index.ts",
    "dev:all": "concurrently -k \"npm:api\" \"npm:dev\"",
    "test:e2e": "playwright test --config playwright.platform.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "backup": "tsx --env-file-if-exists=.env server/platform/backup.ts",
    "test:e2e:legacy": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@craftjs/core": "^0.2.12",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
